<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cashtelo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/secondary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialCardViewStyle">@style/CardStyle</item>
        <!-- Status bar transparente, integrada ao gradiente de fundo -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@color/background</item>
    </style>

    <!-- Estilo de card padrão (fallback) -->
    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/glass_surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
    </style>

    <!-- Estilo para botões outlined de navegação -->
    <style name="Button.Nav" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>

