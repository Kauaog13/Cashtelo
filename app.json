{
  "expo": {
    "name": "Cashtelo",
    "slug": "cashtelo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#32CD32"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cashtelo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#32CD32"
      },
      "package": "com.cashtelo.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "enableFTS": false,
          "useSQLCipher": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e3ef1e38-939d-401f-b618-7fa26e68c46a"
      }
    }
  }
}
